{#- Shared shell for every site page. Generated pages are written to the repo
    root by build.py — edit these templates and data/*.yaml, not *.html. -#}
{% from "site/_macros.html.j2" import anim %}
{% set nav = [
   ("index", "fa-hand-spock-o", "home"),
   ("about", "fa-user-o", "about me"),
   ("skills", "fa-tasks", "skills"),
   ("experience", "fa-briefcase", "experience"),
   ("education", "fa-graduation-cap", "education"),
   ("contact", "fa-volume-control-phone", "contact"),
] %}
{% set b = r.basics %}
<!DOCTYPE html>
<!-- Generated by build.py from data/resume.yaml — do not edit by hand. -->
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta http-equiv="X-UA-Compatible" content="IE=edge">
   <meta name=viewport content="width=device-width, initial-scale=1">

   <title>{{ b.short_name }} | {% block title %}{% endblock %}</title>

   <meta name="description" content="{% block description %}{% endblock %}">
   <meta name="keywords" content="resume, cv, data engineer, ai engineer, physics, space, project management, halifax, canada">
   <meta name="author" content="@rjkowalski">
{% block extra_meta %}{% endblock %}

   <!-- Preloader -->
   <link href="assets/custom/2.2.0/css/preloader.css" property='stylesheet' rel="stylesheet" type="text/css" media="screen"/>

   <!-- CSS -->
   <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous" media="screen">
   <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" property='stylesheet' rel="stylesheet" type="text/css" media="screen"/>
   <link href="assets/vendor/flaticons/flaticon.min.css?v=29022016" property='stylesheet' rel="stylesheet" type="text/css" media="screen"/>
   <link href="assets/vendor/hover/css/hover-min.css?v=2.0.2" property='stylesheet' rel="stylesheet" type="text/css" media="screen"/>
   <link href="assets/vendor/mfp/css/magnific-popup.min.css?v=1.1.0" property='stylesheet' rel="stylesheet" type="text/css" media="screen"/>
   <link href="assets/vendor/owl-carousel/assets/owl.carousel.min.css?v=2.1.0" property='stylesheet' rel="stylesheet" type="text/css" media="screen"/>

   <!-- Custom styles -->
   <link href="assets/custom/2.2.0/css/style.css" property='stylesheet' rel="stylesheet" type="text/css" media="screen"/>
   <link href="assets/custom/2.2.0/css/layouts/samuel.css" property='stylesheet' rel="stylesheet" type="text/css" media="screen"/>
   <link href="assets/custom/2.2.0/css/colors/default.css" id="color-styles" property='stylesheet' rel="stylesheet" type="text/css" media="screen"/>
   <link rel="shortcut icon" href="assets/custom/2.2.0/images/layouts/samuel/favicon.png">
   <link rel="stylesheet" href="assets/vendor/academicons-1.8.2/css/academicons.min.css"/>
   <style>
      #timeline .timeline-heading ul.bullets { margin: 10px 0 0; padding-left: 18px; }
      #timeline .timeline-heading ul.bullets li { font-size: 13px; line-height: 1.5; margin: 0 0 4px; padding: 0 0 0 2px; text-indent: 0; list-style: disc outside; }
      #timeline .timeline-heading ul.bullets li:before, #timeline .timeline-heading ul.bullets li:after { display: none; }
   </style>
</head>

<body id="samuel" class="">

<!--Pre-Loader-->
<div id="preloader"></div>

<header>
   <section id="top-navigation" class="container-fluid nopadding">
      <div class="row nopadding ident ui-bg-color01">
         <!-- Photo -->
         <a href="index.html">
            <div class="col-md-4 vc-photo photo-01">&nbsp;</div>
         </a>
         <!-- /Photo -->
         <div class="col-md-8 vc-name nopadding">
            <!-- Name-Position -->
            <div class="row nopadding name">
               <div class="col-md-10 name-title"><h1 class="font-accident-two-medium">{{ b.name }}</h1></div>
               <div class="col-md-2 nopadding name-pdf">
                  <a href="resume.pdf" class="hvr-sweep-to-right"><i class="flaticon-download149" title="Download Resume.pdf"></i></a>
               </div>
            </div>
            <div class="row nopadding position">
               <div class="col-md-10 position-title">

                  <section class="cd-intro">
                     <h2 class="cd-headline clip is-full-width font-accident-two-light">
                        <span class="cd-words-wrapper">
{% for t in w.rotating_titles %}
                           <b{% if loop.first %} class="is-visible"{% endif %}>{{ t }}</b>
{% endfor %}
                        </span>
                     </h2>
                  </section>

               </div>
               <div class="col-md-2 nopadding pdf">
                  <a href="{{ b.profiles.linkedin }}" class="hvr-sweep-to-right"><i class="flaticon-linkedin22" title="My LinkedIn Profile"></i></a>
               </div>
            </div>
            <!-- /Name-Position -->

            <!-- Main Navigation -->
            <ul id="nav" class="row nopadding cd-side-navigation">
{% for slug, icon, label in nav %}
               <li class="col-xs-4 col-sm-2 nopadding menuitem ui-menu-color0{{ loop.index }}" data-animation-duration="1000" data-animation-delay="{{ 100 + 200 * loop.index0 }}">
                  <a href="{{ slug }}.html" class="hvr-sweep-to-bottom"><i class="fa {{ icon }}" aria-hidden="true"></i><span>{{ label }}</span></a>
               </li>
{% endfor %}
            </ul>
            <!-- /Main Navigation -->

         </div>
      </div>
   </section>
</header>

<!-- Container -->
<div class="content-wrap">
{% block content %}{% endblock %}
</div>

<footer class="padding-50 dark ui-bg-color01" {{ anim("top", 800, duration=500) }}>
   <div class="container-fluid nopadding">
      <div class="row">
         <div class="col-sm-3">
            <h5 class="font-accident-two-bold uppercase">Contact</h5>
            <div class="dividewhite1"></div>
            <ul class="fa-ul">
               <li><a class="color01" href="tel:{{ b.phone }}"><i class="fa-li fa fa-phone"></i> {{ b.phone }}</a></li>
               <li><a class="color01" href="mailto:{{ b.email }}"><i class="fa-li fa fa-envelope"></i> {{ b.email }}</a></li>
            </ul>
            <div class="divider-dynamic"></div>
         </div>
         <div class="col-sm-3 cv-link">
            <h5 class="font-accident-two-bold uppercase">Download Resume</h5>
            <div class="dividewhite1"></div>
            <a href="resume.pdf"><i class="fa fa-long-arrow-down" aria-hidden="true"></i>English</a>
            <p class="inline-block">
               The resume is in <b>.pdf</b> format.
            </p>
            <div class="divider-dynamic"></div>
         </div>
         <div class="col-sm-3">
            <h5 class="font-accident-two-bold uppercase">Learn More</h5>
            <ul class="">
               <li><a class="color01" href="about.html">About Me</a></li>
               <li><a class="color01" href="skills.html">Technical Proficiencies</a></li>
               <li><a class="color01" href="experience.html">Professional Experience</a></li>
               <li><a class="color01" href="education.html">Academic Background</a></li>
               <li><a class="color01" href="contact.html">Contact Me</a></li>
            </ul>
            <div class="divider-dynamic"></div>
         </div>
         <div class="col-sm-3">
            <h5 class="font-accident-two-bold uppercase">Follow me</h5>
            <div class="follow">
               <ul class="list-inline social">
{% for s in w.social %}
                  <li><a target="_blank" href="{{ s.url }}"><i class="{{ s.icon }}"></i></a></li>
{% endfor %}
               </ul>
            </div>
            <div class="divider-dynamic"></div>
         </div>
      </div>
      <div class="dividewhite1"></div>
      <div class="row">
         <div class="col-md-12 copyrights">
            <p>&copy; <script>document.write(new Date().getFullYear())</script> {{ b.short_name }}</p>
         </div>
      </div>
   </div>
</footer>

<!-- Back to Top -->
<div id="back-top"></div>
<!-- /Back to Top -->

<!-- JS -->
<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.4/jquery.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js" integrity="sha384-Tc5IQib027qvyjSMfHjOMaLkfuWVxZxUPnCJA7l2mCWNIpG9mGCD8wGNIcPD7Txa" crossorigin="anonymous"></script>
<script src="https://npmcdn.com/imagesloaded@4.1/imagesloaded.pkgd.min.js"></script>
<script src="https://unpkg.com/isotope-layout@3.0/dist/isotope.pkgd.min.js"></script>
<script src="https://unpkg.com/scrollreveal@3.3.2/dist/scrollreveal.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/velocity/1.2.3/velocity.min.js"></script>

<script src="assets/vendor/mfp/js/jquery.magnific-popup.min.js?v=1.1.0" type="text/javascript"></script>
<script src="assets/vendor/progressbar/progressbar.min.js?v=1.0.1" type="text/javascript"></script>
<script src="assets/vendor/anicounter/jquery.counterup.min.js?v=1.0" type="text/javascript"></script>
<script src="assets/vendor/pjax/jquery.pjax.min.js?v=1.9.6" type="text/javascript"></script>
<script src="assets/vendor/owl-carousel/owl.carousel.min.js?v=2.1.0" type="text/javascript"></script>
<script src="assets/vendor/headlines/headlines.min.js?v=1.0" type="text/javascript"></script>

<!-- Custom scripts -->
<script src="assets/custom/2.2.0/js/animation.js" type="text/javascript"></script>
<script src="assets/custom/2.2.0/js/custom.js" type="text/javascript"></script>

</body>
</html>
